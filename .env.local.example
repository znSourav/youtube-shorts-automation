# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your real key in place of the placeholder below.
GEMINI_API_KEY=your-api-key-here
DATABASE_URL="file:./prisma/dev.db"

# UNIQUE-02: regeneration cap for the uniqueness gate, overridable without a code change
MAX_UNIQUENESS_REGENERATION_ATTEMPTS=3

# D-03: caps how many times a single scene's image or video may be regenerated, separately from the monthly budget
MAX_SCENE_RETRY_ATTEMPTS=3
